# Local dev reads the repo-root .env (MOTH_API_KEY lives there). On Vercel, set these in
# Project → Settings → Environment Variables.
MOTH_API_KEY=your-key-here
# Any long random string (e.g. `openssl rand -hex 32`). Signs job tickets so the proxy only
# serves jobs it created. Optional locally (a random one is generated per dev-server run).
TICKET_SECRET=
# Set to "false" to stop all new jobs instantly (e.g. if credits run low).
SUBMISSIONS_OPEN=true
